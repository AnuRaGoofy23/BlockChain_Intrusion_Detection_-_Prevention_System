# Database connection string
# For local SQLite testing (default):
# DATABASE_URL=sqlite:///./bids.db
# For PostgreSQL:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/bids_db
DATABASE_URL=sqlite:///./bids.db

# Blockchain Node URL (e.g., local Ganache, Hardhat, or Infura/Alchemy)
# BLOCKCHAIN_URL=https://mainnet.infura.io/v3/YOUR_PROJECT_ID
BLOCKCHAIN_URL=http://127.0.0.1:8545

# JWT Secret Key for Authentication
SECRET_KEY=super-secret-key-for-bids
